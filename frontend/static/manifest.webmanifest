{
	"name": "Platedex",
	"short_name": "Platedex",
	"description": "Every plate the crew has spotted, in one shared pool.",
	"start_url": "/upload",
	"scope": "/",
	"display": "standalone",
	"background_color": "#F4F5F3",
	"theme_color": "#13204A",
	"icons": [
		{
			"src": "/icon-192.png",
			"sizes": "192x192",
			"type": "image/png"
		},
		{
			"src": "/icon-512.png",
			"sizes": "512x512",
			"type": "image/png"
		},
		{
			"src": "/icon-512-maskable.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "/icon.svg",
			"sizes": "any",
			"type": "image/svg+xml"
		}
	],
	"share_target": {
		"action": "/share-target",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"files": [
				{
					"name": "photos",
					"accept": ["image/jpeg", "image/png", "image/webp", "image/heic", "image/heif", "image/avif", ".jpg", ".jpeg", ".png", ".webp", ".heic", ".heif", ".avif"]
				}
			]
		}
	}
}
