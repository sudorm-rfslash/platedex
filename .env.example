# ---- Required ----
# The address people open in the browser (HTTPS is needed for the camera and location on phones).
PUBLIC_URL=https://platedex.example.com
# Signs session cookies. Generate with: openssl rand -hex 32
SECRET_KEY=change-me

# ---- Admin settings ----
# Everything below except VLM_MODEL, OLLAMA_URL, IMPORT_* and the *_DEFAULT values can also be set
# in More → Admin. Setting it here LOCKS it: the panel shows it read-only, and the value is saved
# at every start (it stays after you remove the line). Leave a line commented to manage it in the panel.

# ---- Pocket ID (OIDC) — optional ----
# In Pocket ID: create an OIDC client with callback URL  <PUBLIC_URL>/api/auth/oidc/callback
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Members of this Pocket ID group become Platedex admins:
# OIDC_ADMIN_GROUP=platedex_admins
# Create accounts automatically for anyone Pocket ID lets in (control access with Pocket ID groups):
# OIDC_AUTO_CREATE=true
# Link a Pocket ID login to an existing account with the same verified email:
# OIDC_LINK_BY_EMAIL=true
# OIDC_BUTTON_LABEL=Pocket ID
# Username/password sign-in. Locked out? Set this to true, `docker compose up -d`, sign in:
# LOCAL_LOGIN_ENABLED=true

# ---- Plate reading ----
# AI second opinion: auto (only when OCR is unsure), always, or off.
# VLM_MODE_DEFAULT is only the starting value; VLM_MODE=... locks it.
VLM_MODE_DEFAULT=auto
# VLM_MODE=auto
# Ollama vision model. qwen3-vl:8b fits an 8 GB card; use qwen3-vl:4b if you see out-of-memory errors.
VLM_MODEL=qwen3-vl:8b
# Use an Ollama you already run instead of the built-in one:
# OLLAMA_URL=http://192.168.1.10:11434
# Percent confidence below which a reading goes to Verify. *_DEFAULT = starting value; OCR_THRESHOLD locks it.
# OCR_THRESHOLD_DEFAULT=85
# OCR_THRESHOLD=85

# ---- Uploads ----
# MAX_UPLOAD_MB=25
# Watch folder (mount it in docker-compose.yml):
# IMPORT_DIR=/import
# IMPORT_USER=alex
# iCloud link to the iOS Shortcut (README → iOS Shortcut):
# SHORTCUT_URL=https://www.icloud.com/shortcuts/...

# ---- Map tiles ----
# Defaults to OpenFreeMap (free, no key). Point these at your own styles for a fully offline setup.
# MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
# MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
